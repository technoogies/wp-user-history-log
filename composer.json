{
    "name": "technoogies/wp-user-history-log",
    "description": "WordPress user history audit plugin",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "scripts": {
        "lint": "parallel-lint --exclude vendor .",
        "test": "phpunit --testsuite unit,integration",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration",
        "test:multisite": "WP_TESTS_MULTISITE=1 phpunit --testsuite multisite"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6.38",
        "yoast/phpunit-polyfills": "^4.0",
        "php-parallel-lint/php-parallel-lint": "^1.4"
    },
    "config": {
        "platform": {
            "php": "7.4.33"
        }
    }
}
